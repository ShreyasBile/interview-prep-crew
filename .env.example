# Copy to .env and pick ONE model.

# Port to start on; if it is taken, the next free port is used.
# PORT=8010

# Option A: Groq (fast, free tier; key from console.groq.com)
MODEL=groq/openai/gpt-oss-120b
GROQ_API_KEY=

# Option B: Claude (key from console.anthropic.com)
# MODEL=anthropic/claude-opus-5-5
# ANTHROPIC_API_KEY=
# MAX_TOKENS=16000

# Option C: free and offline with Ollama (run scripts\setup_ollama.ps1 once)
# MODEL=ollama/interview-prep-qwen3
# Use 127.0.0.1, not "localhost": on Windows localhost tries IPv6 first and adds ~2s per call.
# OLLAMA_HOST=http://127.0.0.1:11434
